# VCS / toolchain noise
.git
.gitignore
.lake
.lake-cache

# Virtualenvs and bytecode (never ship the host's, even if present)
# NOT: bare isimler yalnız context kökünde eşleşir. `_calisma/.venv_z3`
# (host'un z3 venv'i) bu yüzden imaja sızıyordu ve Trivy gate'ini
# besliyordu: pillow-11.3.0 + setuptools-58.0.4 dist-info'ları 16+ HIGH
# CVE ile taranıyordu (CI'da venv olmadığı için görünmüyordu — yerel
# build ile CI build'i ayrışıyordu). `**/` ile her derinlikte hariç tut.
.venv
.venv_z3
**/.venv
**/.venv_z3
**/__pycache__
*.pyc

# Node scratch / tooling
node_modules
package-lock.json
# Bare isimler yalnız kök düzeyini yakalar — aynı sızıntı sınıfı (venv notu):
# linked worktree'ler (bayat lock/node_modules) ve app build çıktıları context'e
# sızıyordu ve Trivy gate'ini besliyordu (ölçüldü: .worktrees'taki eski lock
# postcss 8.4.31 + sharp 0.34.5 HIGH bulguları üretti; CI'da yok — yerel/CI ayrışıyordu).
.worktrees
**/node_modules
**/.next

# Node çalışma alanı BUILD ÇIKTILARI (kaynak-değil; image'a girmemeli).
# Bare ad kuralının devamı: `dist` yalnız kökte eşleşir, oysa js build
# çıktısı her çalışma alanında derinlikte doğar (apps/dashboard-shadcn/dist,
# _calisma/video/dist). Aynı sınıf: bu dizinler imaja girerse Trivy, üreten
# node sürümünü kaynak sanıp tarar (2026-09-20 sızıntısının kardeşi).
**/dist
**/.vite
**/tsconfig.tsbuildinfo
# Deck/video üretim çıktıları (gitignore'lu; image'a girecek bir şey değil).
**/*.pptx
# prisma client üretimi (npm run db:generate) — kaynak ağacı değil.
apps/trend-db/generated

# Editor / OS
.DS_Store
.idea
.vscode

# Vercel link state (host-specific, not runtime)
.vercel
