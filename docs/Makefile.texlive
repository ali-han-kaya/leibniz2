# Reproducible PDF build via TeXLive (pdfTeX) — docs/Makefile.tectonic'in
# Faz 1 ikizi (docs/TEXLIVE_MIGRATION_PLAN.md).
# Usage:
#   make -f docs/Makefile.texlive pdf
#   make -f docs/Makefile.texlive check
#   make -f docs/Makefile.texlive accept
#   make -f docs/Makefile.texlive clean
#   make -f docs/Makefile.texlive plate-book        (Incidental Proof levha kitabi)
#   make -f docs/Makefile.texlive plate-book-check  (levhalar+kitap: 2x bagimsiz SDE kosumu)
#
# SOURCE_DATE_EPOCH is explicit so the build does not depend on wall-clock
# time. Override SOURCE_DATE_EPOCH=... to reproduce a historical commit.
#
# 3-geçiş sözleşmesi (plan Faz 0): her target tam PASSES geçiş koşar; son
# geçiş logunda 'Rerun to get' kalmadan hizalama iddiası ÜRETİLEMEZ
# (fail-closed). pdf çıktıyı yalnız BUILD_DIR'a yazar, sonra OUTPUT'a
# kopyalar — kaynak dizinine ASLA yazılmaz. check, deney betiğini
# DETERMINISM_PASSES=$(PASSES) ile delege eder: 2 bağımsız 3-geçişli koşum
# + /ID-kanonik hash karşılaştırması + rerun=0 denetimi.
# accept: Faz 3 — check'i koşturur, kanonik hash'i kabul raporunun hash
# geçiş defterinde (docs/ID_RESIDUAL_ACCEPTANCE.md §4) arar; yoksa
# fail-closed (yeni bağlam → bilinçli defter satırı, Faz 6 çıkış yolu).
# Makefile.tectonic paralel yaşamlı kalır (geri dönüş yolu).
#
# SOURCE_DATE_EPOCH SÖZLEŞMESİ (2026-10-02 ölçümü): `pdf` hedefi epoch'u
# motor ortamına İHRAÇ EDER; `check`/`accept` ihraç etmiyordu, bu yüzden
# determinizm betiği kendi varsayılanına (`:-0`) düşüyordu. Sonuç: kabul
# edilen PDF ile teslim edilen PDF FARKLI epoch ile derleniyordu — kabul
# ettiğimiz şey gönderdiğimiz şey değildi (ölçüm: epoch 12345 iken kanonik
# hash 544516b0… yerine 95900f50… çıktı). `check` artık epoch'u da ihraç
# eder; kabul edilen byte'lar üretilen byte'larla aynı epoch'tadır.
#
# VARSAYILAN SDE (2026-10-02 düzeltmesi): ilk ölçümde varsayılan HEAD'in
# commit zamanıydı; bu, kanonik hash'i HER COMMIT'tE değiştiriyor ve yerel
# `make accept`'i yalnız HEAD'in o commit'e denk gelmesi hâlinde yeşil
# bırakıyordu (ölçüldü: HEAD bcb963b iken yerel accept kırmızı).
# Kabul edilebilir bir çıktı commit'e bağlı olamaz; varsayılan bu yüzden
# teslim sabitine (2026-08-17T00:00:00Z) çivilendi. Böylece `pdf`,
# `check` ve `accept` aynı epoch'ta çalışır, hash commit'ten bağımsızdır
# ve hem yerel (defter satır 7) hem CI-linux (satır 8) bağlamı yeşildir.
# Başka epoch denemek için: `SOURCE_DATE_EPOCH=... make ... accept`
# (o epoch'un kanonik hash'i defterde yoksa bilinçli kırmızı verir).

SHELL := /bin/sh
ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
PACKAGE := $(ROOT)/_calisma/V5_ICERIK/TESLIM_V5_FINAL_2026-08-17/stoic_hume_package/Stoic_Hume_Formal_Section_2026-08-17
SOURCE ?= $(PACKAGE)/ingiliz_empirizmi_v3.tex
OUTPUT ?= $(PACKAGE)/ingiliz_empirizmi_v3.pdf
TEXDIR := $(abspath $(dir $(SOURCE)))
TEXBASE := $(notdir $(SOURCE))
STEM := $(TEXBASE:.tex=)
BUILD_DIR ?= $(ROOT)/.build/texlive
# Teslim sabiti 2026-08-17T00:00:00Z. Ortam değişkeni verilirse o kazanır
# (`?=`), yani CI kabul işi kendi pinli epoch'unu buraya zorlamaz.
SOURCE_DATE_EPOCH ?= 1786924800
PDFlatex ?= pdflatex
PDBIN := $(shell command -v $(PDFlatex) 2>/dev/null)
PASSES ?= 3
DETERMINISM_SCRIPT := $(abspath $(ROOT)/_calisma/CIKTI/texlive_determinism_test.sh)
ACCEPT_DOC := $(ROOT)/docs/ID_RESIDUAL_ACCEPTANCE.md
REPORT := $(BUILD_DIR)/determinism_report.txt

.PHONY: all pdf check accept clean engineinfo plate-book plate-book-check plate-book-clean

all: pdf

# Faz 0 motor kilidi + sözleşme sabitleri (plan §Faz 0): sürüm çıktısı
# makine-okur pdtex_version= satırıyla log'a düşer (CI'da kanıt kalır).
engineinfo:
	@command -v "$(PDFlatex)" >/dev/null 2>&1 || { echo "ERROR: pdflatex not found (PDFlatex= veya PATH)" >&2; exit 2; }
	@$(PDBIN) -version | head -1 | sed 's/^/pdtex_version=/'
	@echo "engine_lock=pdfTeX 3.141592653-2.6 (TeX Live 2026; plan Faz 0 motor kilidi)"
	@echo "texinputs_contract=TEXINPUTS=$(TEXDIR)//: (input bağımlılıkları: core_section)"
	@echo "texmfoutput_contract=TEXMFOUTPUT=$(BUILD_DIR)"
	@echo "output_dir_contract=-output-directory=$(BUILD_DIR) — kaynak dizinine ASLA yazma"
	@echo "source_date_epoch=$(SOURCE_DATE_EPOCH)"
	@echo "passes=$(PASSES)"

pdf:
	@command -v "$(PDFlatex)" >/dev/null 2>&1 || { echo "ERROR: pdflatex not found (PDFlatex= veya PATH)" >&2; exit 2; }
	@test -f "$(SOURCE)" || { echo "ERROR: TeX source not found: $(SOURCE)" >&2; exit 1; }
	@mkdir -p "$(BUILD_DIR)"
	@i=1; while [ "$$i" -le "$(PASSES)" ]; do \
	  echo "pdflatex pass $$i/$(PASSES)"; \
	  TEXLIVE_PASS_INDEX="$$i" TEXLIVE_PASSES="$(PASSES)" \
	  SOURCE_DATE_EPOCH="$(SOURCE_DATE_EPOCH)" \
	  TEXINPUTS="$(TEXDIR)//:" TEXMFOUTPUT="$(BUILD_DIR)" \
	  "$(PDFlatex)" -interaction=nonstopmode -halt-on-error \
	    -output-directory="$(BUILD_DIR)" "$(SOURCE)" >/dev/null || exit 1; \
	  i=$$((i + 1)); \
	done
	@if grep -q 'Rerun to get' "$(BUILD_DIR)/$(STEM).log"; then \
	  echo "ERROR: son geçiş logunda 'Rerun to get' kaldı — $(PASSES) geçiş hizalamayı tamamlamadı (Faz 0 sözleşmesi)" >&2; \
	  grep -n 'Rerun to get' "$(BUILD_DIR)/$(STEM).log" >&2; exit 1; \
	fi
	@cp "$(BUILD_DIR)/$(STEM).pdf" "$(OUTPUT)"
	@printf 'built=%s\npasses=%s\nsource_date_epoch=%s\n' "$(OUTPUT)" "$(PASSES)" "$(SOURCE_DATE_EPOCH)"

check:
	@command -v "$(PDFlatex)" >/dev/null 2>&1 || { echo "ERROR: pdflatex not found (PDFlatex= veya PATH)" >&2; exit 2; }
	@test -f "$(DETERMINISM_SCRIPT)" || { echo "ERROR: deney betiği yok: $(DETERMINISM_SCRIPT)" >&2; exit 1; }
	@mkdir -p "$(BUILD_DIR)"
	@PDBIN="$$(command -v "$(PDFlatex)")"; \
	 test -n "$$PDBIN" || { echo "ERROR: pdflatex not found (PDFlatex= veya PATH)" >&2; exit 2; }; \
	TEX_SOURCE="$(SOURCE)" \
	SOURCE_DATE_EPOCH="$(SOURCE_DATE_EPOCH)" \
	TEXLIVE_BIN="$${PDBIN%/*}" \
	DETERMINISM_PASSES="$(PASSES)" \
	DETERMINISM_OUT="$(REPORT)" \
	bash "$(DETERMINISM_SCRIPT)" || exit 1
	@grep -q '^passes=$(PASSES)$$' "$(REPORT)" || { echo "ERROR: raporda passes=$(PASSES) yok — geçiş sözleşmesi rapora yansımadı" >&2; exit 1; }
	@grep -q '^verdict=PASS' "$(REPORT)" || { echo "ERROR: determinism verdict PASS değil" >&2; exit 1; }
	@grep -q '^texlive_run1_rerun_left=0$$' "$(REPORT)" || { echo "ERROR: run1 rerun_left=0 değil" >&2; exit 1; }
	@grep -q '^texlive_run2_rerun_left=0$$' "$(REPORT)" || { echo "ERROR: run2 rerun_left=0 değil" >&2; exit 1; }
	@echo "── TeXLive determinism check kanıtı ──"
	@grep -E '^(passes|source_date_epoch|texlive_canonical_run1_sha256|texlive_canonical_run2_sha256|residual|verdict)=' "$(REPORT)"

accept: check
	@CANON=$$(sed -n 's/^texlive_canonical_run1_sha256=//p' "$(REPORT)"); \
	 test -n "$$CANON" || { echo "ERROR: raporda kanonik hash yok" >&2; exit 1; }; \
	 if grep -q "$$CANON" "$(ACCEPT_DOC)"; then \
	   echo "── Faz 3 kabul ──"; \
	   echo "KABUL: kanonik hash kabul raporunun hash geçiş defterinde"; \
	   echo "canon=$$CANON"; \
	 else \
	   echo "ERROR: kanonik hash kabul raporunun hash geçiş defterinde yok: $$CANON" >&2; \
	   echo "       Yeni bağlam (CI/font paketi) ise docs/ID_RESIDUAL_ACCEPTANCE.md" >&2; \
	   echo "       defterine bu ikiliyi bilinçli ekle (Faz 6 çıkış yolu), sonra tekrar koş." >&2; \
	   exit 1; \
	 fi

clean:
	rm -rf "$(BUILD_DIR)"

# ============================================================================
# PLATE-BOOK — Incidental Proof (canvas ailesi)
# ----------------------------------------------------------------------------
# Bu dosyanin geri kalani el yazmasini pdfTeX ile derler. Canvas ailesi
# fontspec + yerel font (BigShoulders/GeistMono) kullanir: XeTeX sozlesmesi,
# pdfTeX bu kaynagi DERLEYEMEZ (olculmustu; canvas kaynagi icin ayri deney
# betigi tam bu yuzden var). plate-book hedefleri bu nedenle tectonic ile
# kosar; motor pini tek kaynaktir ve CI'dadir (determinism-trend.yml
# "Run canvas determinism experiment (plate-book, 6 kaynak)" adimi: surum +
# sha256 digest — TEK tectonic kurulumu manuscript deneyiyle paylasilir;
# adim tectonic KURMAZ, calistirir. Kaynak listesi adimin env
# CANVAS_SOURCES'i asagidaki PLATE_SOURCES + PLATE_BOOK'i BIREBIR kopyalar;
# iki liste test_trend_schedule_paths anti-drift kapisiyla kilitlenmistir).
#
# SDE AILE AYRIMI: el yazmasinin sabiti 1786924800; levha kitabinin sabiti
# 1700000000 (workflow canvas olcum adimi ve kanit raporlariyla ayni;
# ucu da test_record_determinism_trend ile kilitli).
# PLATE_BOOK_EPOCH bilerek SOURCE_DATE_EPOCH'tan TURETILMEZ: aksi halde el
# yazmasi epoch'u canvas PDF'lerini sessizce yeniden damgalar ve
# commit'lenmis baytlar yeniden uretilemez (el yazmasinda 2026-10-02'de
# olculen hatanin aile icindeki ikizi).
#
# Yazma sozlesmesi `pdf` ile ayni: derleme YALNIZ PLATE_BUILD_DIR'a yazar,
# sonra kanonik levha yollarina KOPYALANIR; derleyici kaynak dizinine asla
# yazmaz. Levhalar kitaptan ONCE derlenip kopyalanir: kitap onlari
# \includegraphics ile gomer, yani gomulu levha derleme aninda KANONIK
# yoldan (yeniden uretilmis haliyle) okunur — aksi halde kitap, kanonik
# dizinde duran onceki nesil levhalari gomerdi ve `plate-book` ikinci
# kosumda farkli bayt uretirdi (olculdu: levha ust-verisi kitaba sizmaz,
# yalniz icerik akislari; bu yuzden sira kitap icerigini degistirmez,
# ama sozlesme yine de "once levha"dir).
PLATE_DIR ?= $(ROOT)/_calisma/CIKTI/canvas
PLATE_BOOK := $(PLATE_DIR)/incidental_proof_book.tex
PLATE_SOURCES := $(PLATE_DIR)/incidental_proof_canvas.tex \
                 $(PLATE_DIR)/incidental_proof_plate02.tex \
                 $(PLATE_DIR)/incidental_proof_plate03.tex \
                 $(PLATE_DIR)/incidental_proof_plate04.tex \
                 $(PLATE_DIR)/incidental_proof_plate05.tex
PLATE_BUILD_DIR ?= $(ROOT)/.build/plate-book
PLATE_BOOK_EPOCH ?= 1700000000
PLATE_TECTONIC ?= tectonic
PLATE_DETERMINISM_SCRIPT := $(abspath $(ROOT)/_calisma/CIKTI/canvas_determinism_test.sh)
PLATE_REPORT_DIR ?= $(PLATE_BUILD_DIR)/determinism

plate-book:
	@command -v "$(PLATE_TECTONIC)" >/dev/null 2>&1 || { echo "ERROR: tectonic not found (PLATE_TECTONIC= veya PATH) - canvas ailesi XeTeX sozlesmesi, pdfTeX derleyemez" >&2; exit 2; }
	@test -f "$(PLATE_BOOK)" || { echo "ERROR: plate-book kaynagi yok: $(PLATE_BOOK)" >&2; exit 1; }
	@mkdir -p "$(PLATE_BUILD_DIR)"
	@for src in $(PLATE_SOURCES); do \
	  test -f "$$src" || { echo "ERROR: levha kaynagi yok: $$src" >&2; exit 1; }; \
	  echo "plate-book: $$(basename "$$src")"; \
	  ( cd "$(PLATE_DIR)" && SOURCE_DATE_EPOCH="$(PLATE_BOOK_EPOCH)" \
	      "$(PLATE_TECTONIC)" --outdir "$(PLATE_BUILD_DIR)" "$$src" ) || exit 1; \
	done
	@for src in $(PLATE_SOURCES); do \
	  out="$(PLATE_BUILD_DIR)/$$(basename "$${src%.tex}").pdf"; \
	  test -f "$$out" || { echo "ERROR: tectonic --outdir honor edilmedi: $$out yok" >&2; exit 1; }; \
	  cp "$$out" "$${src%.tex}.pdf"; \
	done
	@echo "plate-book: $$(basename "$(PLATE_BOOK)")"
	@( cd "$(PLATE_DIR)" && SOURCE_DATE_EPOCH="$(PLATE_BOOK_EPOCH)" \
	      "$(PLATE_TECTONIC)" --outdir "$(PLATE_BUILD_DIR)" "$(PLATE_BOOK)" ) || exit 1
	@book_out="$(PLATE_BUILD_DIR)/$$(basename "$(PLATE_BOOK:.tex=.pdf)")"; \
	 test -f "$$book_out" || { echo "ERROR: tectonic --outdir honor edilmedi: $$book_out yok" >&2; exit 1; }; \
	 cp "$$book_out" "$(PLATE_BOOK:.tex=.pdf)"
	@printf 'plate_book=%s\nplates=%s\nsource_date_epoch=%s\n' "$(PLATE_BOOK)" "$(words $(PLATE_SOURCES))" "$(PLATE_BOOK_EPOCH)"
	@for src in $(PLATE_SOURCES) $(PLATE_BOOK); do \
	  printf 'sha256=%s  %s\n' "$$(sha256sum "$${src%.tex}.pdf" | awk '{print $$1}')" "$${src%.tex}.pdf"; \
	done

# Determinizm kapisi: kaynak basina 2 BAGIMSIZ SDE kosumu + kanonik
# karsilastirma, tek kaynak = canvas_determinism_test.sh (hash cikarimi
# burada TEKRARLANMAZ). verdict=PASS yoksa hedef fail-closed duser; hicbir
# kaynak atlanmaz (kitap + derledigimiz bes levha).
plate-book-check:
	@command -v "$(PLATE_TECTONIC)" >/dev/null 2>&1 || { echo "ERROR: tectonic not found (PLATE_TECTONIC= veya PATH)" >&2; exit 2; }
	@test -f "$(PLATE_DETERMINISM_SCRIPT)" || { echo "ERROR: canvas deney betigi yok: $(PLATE_DETERMINISM_SCRIPT) - plate-book determinizm kapisi fail-closed" >&2; exit 1; }
	@test -f "$(PLATE_BOOK)" || { echo "ERROR: plate-book kaynagi yok: $(PLATE_BOOK)" >&2; exit 1; }
	@mkdir -p "$(PLATE_REPORT_DIR)"
	@for src in $(PLATE_SOURCES) $(PLATE_BOOK); do \
	  stem="$$(basename "$${src%.tex}")"; \
	  report="$(PLATE_REPORT_DIR)/$$stem.determinism.txt"; \
	  SOURCE_DATE_EPOCH="$(PLATE_BOOK_EPOCH)" \
	    TEX_SOURCE="$$src" \
	    TECTONIC_BIN="$$(command -v "$(PLATE_TECTONIC)")" \
	    DETERMINISM_OUT="$$report" \
	    bash "$(PLATE_DETERMINISM_SCRIPT)" || exit 1; \
	  grep -q '^verdict=PASS' "$$report" || { echo "ERROR: $$stem determinism verdict PASS degil ($$report)" >&2; exit 1; }; \
	done
	@echo "-- plate-book determinism kaniti (kaynak basina 2 bagimsiz SDE kosumu) --"
	@grep -hE '^(source_date_epoch|tectonic_run1_sha256|tectonic_run2_sha256|residual|verdict)=' $(PLATE_REPORT_DIR)/*.determinism.txt

plate-book-clean:
	rm -rf "$(PLATE_BUILD_DIR)"
