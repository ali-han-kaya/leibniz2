# isolated worktrees (using-git-worktrees skill)
.worktrees/

# make build dirs (docs/Makefile.tectonic + docs/Makefile.texlive BUILD_DIR)
.build/

# planning-with-files: plan attestation = yerel SHA-256 kilidi, makine-özgü.
# task_plan.md/findings.md/progress.md takip EDİLİR; bu kilit dosyası değil.
.plan-attestation
.planning/.active_plan
.vercel
.env*

# tarayici-QA arac zinciri (npm) bu dizin/symlink'leri olusturur
# (sonu '/' olmayan kural: node_modules SYMLINK'i de yakalar —
# 'beyond a symbolic link' tuzaği, 2026-10-09)
node_modules
