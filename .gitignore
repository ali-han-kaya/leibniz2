# Build/runtime artifact'ları — kaynak değil, her koşumda yeniden üretilir
__pycache__/
*.pyc
_calisma/CIKTI/logs/
_calisma/lean_reduct/.lake/
_calisma/lean_reduct/lake-manifest.json
apps/dashboard-shadcn/node_modules/
apps/dashboard-shadcn/dist/
