<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.freebuff.preview-server</string>
  <key>ProgramArguments</key>
  <array>
    <!-- PreStart kontrolü: preview_prestart.py mirror bayatlığını sunucudan
         ÖNCE denetler (eksik/bozuk/drift → sunucu hiç başlamaz, exit 1).
         PASS'te ayraç sonrası sunucu komutunu exec eder (PID korunur). -->
    <string>/usr/bin/python3</string>
    <string>/Users/ci/Library/Caches/com.freebuff/preview/preview_prestart.py</string>
    <string>--preview-dir</string>
    <string>/Users/ci/Library/Caches/com.freebuff/preview</string>
    <string>--verify-dir</string>
    <string>/Users/ci/Library/Caches/com.freebuff/verify</string>
    <string>--label</string>
    <string>com.freebuff.preview-server</string>
    <string>--log</string>
    <string>/Users/ci/Library/Logs/com.freebuff/prestart-preview-server.log</string>
    <string>--</string>
    <string>/Users/ci/Library/Caches/com.freebuff/preview/preview_server.py</string>
    <string>--dir</string>
    <string>/Users/ci/Library/Caches/com.freebuff/verify</string>
    <string>--preview-dir</string>
    <string>/Users/ci/Library/Caches/com.freebuff/preview</string>
    <string>--port</string>
    <string>8000</string>
    <string>--interval</string>
    <string>60</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ci/Library/Logs/com.freebuff/preview-server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ci/Library/Logs/com.freebuff/preview-server.log</string>
</dict>
</plist>
