+def mockModel (p : Prop) : L0Structure MockImp MockCont MockEp :=
+  { Kat := fun _ => p
+    Rep := fun _ _ => p
+    Grasp := fun _ _ => p
+    Assent := fun _ _ => p
+    Bel := fun _ _ => p
+    Causal := fun _ _ => p
